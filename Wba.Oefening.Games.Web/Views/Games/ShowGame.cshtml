@model GamesShowGameViewModel
<div class="row">
    <div class="col col-4 mx-auto">
        <div class="card text-center">
            <div class="card-header">
                @Model.Name
            </div>
            <div class="card-body">
                <div class="card-title">
                    <a class="link-info" asp-controller="Developers"
                       asp-action="ShowDeveloper"
                       asp-route-id="@Model.Developer.Id">@Model.Developer.Name</a>
                       
                </div>
            </div>
            <div class="card-footer">
                @Model.Rating
            </div>
            <a asp-controller="Games" asp-action="Index" class="btn btn-outline-info">Back</a>
        </div>
    </div>
</div>


