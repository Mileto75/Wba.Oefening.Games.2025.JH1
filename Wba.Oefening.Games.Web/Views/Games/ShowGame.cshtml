@model GamesShowGameViewModel
<div class="row">
    <div class="col col-4 mx-auto text-center">
        <div class="card" style="width: 18rem;">
            <!--tips: add .text-center,.text-right to the .card to change card text alignment-->
            <img src="~/images/@Model.Image" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">@Model.Name</h5>
                <h6 class="card-subtitle mb-2 text-muted">Developer</h6>
                <p class="card-text">@Model.Developer.Name</p>
                <a asp-controller="Games" asp-action="Index" class="btn btn-primary">Back</a>
                <div class="card-footer">
                    @* show the stars *@
                    @for(int i = 0;i <5;i++)
                    {
                        if(i < Model.Rating)
                        { 
                            <i class="icon-star"></i>
                        }
                        else
                        { 
                            <i class="icon-star-empty"></i>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>


